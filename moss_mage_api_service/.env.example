# Checkpoints
MOSS_MODEL_PATH=
MAGE_MODEL_PATH=

# Optional Python overrides; blank model interpreters use service-local venvs.
MOSS_PYTHON=
MAGE_PYTHON=
BASE_PYTHON=python3

# Network and GPU assignment. Blank GPU sets use every job-visible GPU.
HOST=0.0.0.0
MOSS_PORT=8102
MAGE_PORT=8103
MOSS_GPUS=
MAGE_GPUS=
MODEL_DEVICE_MAP=balanced
ALLOWED_LOCAL_MEDIA_ROOTS=/tmp

# Runtime defaults aligned with the checkpoint-native inference paths.
ATTN_IMPLEMENTATION=sdpa
RESPONSE_WAIT_SECONDS=1.0
MAX_TOKENS_PER_SECOND=12
REALTIME_MAX_NEW_TOKENS=4096
REALTIME_FRAME_QUEUE_SIZE=256
MAGE_SEGMENT_SECONDS=8
MAGE_SEGMENT_FRAMES=16
MAGE_CUR_FPS=2
MAGE_GATE_THRESHOLD=0.5
MAGE_MAX_NEW_TOKENS=80
MAGE_MAX_SEGMENTS=0
SESSION_TIMEOUT_SECONDS=900
