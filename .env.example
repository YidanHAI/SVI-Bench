# Copy to .env, fill every value required by the models you run, then chmod 600 .env.

# Recording WebUI
JOYVL_WEB_URL=
JOYVL_WEB_USERNAME=
JOYVL_WEB_PASSWORD=

# JoyAI adapter
JOYAI_API_BASE=
JOYAI_API_KEY=

# Doubao / Volcengine Ark
DOUBAO_API_BASE=
ARK_API_KEY=

# Mage service
MAGE_API_BASE=
MAGE_REALTIME_API_BASE=
MAGE_API_KEY=

# MOSS service
MOSS_API_BASE=
MOSS_REALTIME_API_BASE=
MOSS_API_KEY=

# MiniCPM-O service
MODELBEST_API_BASE=
MODELBEST_REALTIME_API_BASE=
MODELBEST_API_KEY=

# OpenAI-compatible GPT-5.5 Judge
OPENAI_BASE_URL=
OPENAI_API_KEY=
JUDGE_MODEL=GPT-5.5

# Judge inputs. Set exactly one recording source.
BENCHMARK_WORKBOOK=data/SVIBench-开源表.xlsx
JUDGE_RECORDING_RUN=
# JUDGE_RECORDING_INDEX=/absolute/path/to/recording_manifest.jsonl

# Optional local overrides
# VL_INTERACTION_CAMPAIGN_CONFIG=config/recording_campaign.local.json
# PIPELINE_OUTPUT_ROOT=outputs/pipeline
# JUDGE_OUTPUT_ROOT=outputs/judge_campaign/custom_run
# PIPELINE_POLL_SECONDS=30
# VL_INTERACTION_ENV_FILE=/absolute/path/to/private.env
